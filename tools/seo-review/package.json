  "version": "1.0.0",
  "description": "SEO Review: local SEO audits for Developer of Code, LLC. Served at /admin/seo/ behind the admin login.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:open": "VITE_SEO_SKIP_AUTH=1 vite",
    "dev:demo": "VITE_SEO_DEMO=1 vite",
