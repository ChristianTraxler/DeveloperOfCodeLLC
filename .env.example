# Copy to .env.local for `npm run dev`. On Vercel, set these under Project → Settings → Environment Variables.
# .env.local is gitignored. Only VITE_* keys ever reach the browser; everything below stays server-side.

# /api/notify — the "Notify me" launch list (Resend). Required for sign-ups to send.
RESEND_API_KEY=
# Optional: verified sender and the inbox that receives each sign-up.
# NOTIFY_FROM="Developer Of Code, LLC <notify@developerofcode.com>"
# NOTIFY_TO=DeveloperOfCodeLLC@Gmail.com

# /api/status — footer status badge. Optional; defaults to https://status.developerofcode.com
# STATUS_PAGE_URL=

# /api/keep-alive — daily Supabase ping (Vercel Cron). Optional; public defaults are built in.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# CRON_SECRET=

# /api/demos: demo uploads from /admin/demos/. Required for uploads to work.
# SUPABASE_URL / SUPABASE_ANON_KEY above are reused (they fall back to the VITE_* values).
# SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed to manage demos.
# ADMIN_EMAILS=
# Team-scoped token with an expiry, separate from the GitHub Actions VERCEL_TOKEN.
# DEMOS_VERCEL_TOKEN=
# VERCEL_TEAM_ID=team_ZHrqgA7Yqy4Sytp7oFx7qgqx

# /api/seo: SEO Review at /admin/seo/. Reuses SUPABASE_SERVICE_ROLE_KEY and ADMIN_EMAILS above.
# Free Google PageSpeed Insights API key (Google Cloud console -> APIs -> PageSpeed Insights API -> Credentials).
# Without it, the page speed check is skipped and everything else still runs.
# PAGESPEED_API_KEY=
# Google Places API (New) key for the local layer (Business Profile, reviews, competitors).
# Google Cloud console -> enable "Places API (New)" -> Credentials, restrict the key to it.
# Needs a billing account; free monthly allowance, then paid. Without it, those checks are skipped
# and competitors can be added by hand.
# GOOGLE_PLACES_API_KEY=
