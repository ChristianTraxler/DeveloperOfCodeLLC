.vercel
.claude/settings.local.json

# Dependencies
node_modules/

# Build output
dist/
dist-single/
# Tracker build output (regenerated from tools/project-tracker on every deploy)
public/admin/tracker/
# Outlay build output (regenerated from tools/outlay on every deploy)
public/admin/outlay/
# Marketing build output (regenerated from tools/marketing on every deploy)
public/admin/marketing/
# Mail build output (regenerated from tools/mail on every deploy)
public/admin/mail/
# SEO Review build output (regenerated from tools/seo-review on every deploy)
public/admin/seo/

# Local env + cruft (.env.example is the committed template)
.env
.env.*
!.env.example
.DS_Store
*.log

# DOC Tracker project mapping (harmless, but no need to ship it)
.doc-tracker.json

# Dependencies excluded from iCloud (node_modules links to node_modules.nosync)
node_modules
node_modules.nosync

# Mail setup values with secrets (filled cron SQL, Pub/Sub push URL). Never commit.
supabase/*.local.*
supabase/.temp/
